# ==========================================
# Online Home Tution Center - Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Example local: mongodb://127.0.0.1:27017/online_home_tution
# Example Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/online_home_tution?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/online_home_tution

# JWT Authentication Secret Key
JWT_SECRET=tuition_web_super_secure_secret_jwt_key_2026

# Client Application URL
CLIENT_URL=http://localhost:5173
